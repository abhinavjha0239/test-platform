# ============================================
# Docker Ignore File
# ============================================
# Speeds up Docker builds by excluding unnecessary files

# Git
.git
.gitignore

# Dependencies (will be installed in container)
node_modules
*/node_modules
**/node_modules

# Build outputs (will be built in container)
.next
apps/web/.next
dist
*/dist
**/dist

# Development files
.env
.env.*
!.env.example
*.local

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage
.nyc_output

# Documentation
*.md
!README.md
docs

# Misc
.turbo
.eslintcache
*.tsbuildinfo

# Backups
backups

# Terminals (cursor)
terminals


