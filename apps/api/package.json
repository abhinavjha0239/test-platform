{
    "name": "@exam-platform/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -n api,worker -c blue,green \"tsx watch src/server.ts\" \"tsx watch src/workers/grading-worker.ts\"",
        "dev:api": "tsx watch src/server.ts",
        "dev:worker": "tsx watch src/workers/grading-worker.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "worker": "tsx src/workers/grading-worker.ts",
        "worker:dev": "tsx watch src/workers/grading-worker.ts",
        "lint": "eslint src/"
    },
    "dependencies": {
        "@exam-platform/database": "*",
        "@exam-platform/shared": "*",
        "@socket.io/redis-adapter": "^8.3.0",
        "bcryptjs": "^2.4.3",
        "bullmq": "^5.66.4",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "drizzle-orm": "^0.38.3",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "generic-pool": "^3.9.0",
        "helmet": "^7.1.0",
        "ioredis": "^5.8.2",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "postgres": "^3.4.5",
        "rate-limit-redis": "^4.3.1",
        "socket.io": "^4.8.3",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/generic-pool": "^3.1.11",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.10.0",
        "concurrently": "^9.2.1",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    }
}
