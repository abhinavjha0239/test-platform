# Environment Variables Example
# Copy this to .env and fill in values

# SQL Grader Configuration
SQL_GRADER_DATABASE_URL=postgres://grader_service:your_password@localhost:5433/sql_grader     # Public tests (sample data)
SQL_HIDDEN_DATABASE_URL=postgres://grader_service:your_password@localhost:5434/sql_hidden     # Hidden tests (more/edge case data)
SQL_CONTAINER_POOL_SIZE=3
SQL_CONTAINER_REMOTE_HOST=         # Leave empty for local Docker, or set to spot VM IP for remote
