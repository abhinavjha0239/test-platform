# ============================================
# Exam Platform - Azure Environment Variables
# ============================================
# Copy to .env.production and fill in actual values
# SECURITY: Never commit .env.production to version control!
# ============================================

# ============================================
# Domain & URLs
# ============================================
DOMAIN=your-domain.com
FRONTEND_URL=https://your-domain.com

# ============================================
# Azure Database for PostgreSQL Flexible Server
# ============================================
# Format: postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
DATABASE_URL=postgresql://examadmin:YOUR_PASSWORD@exam-pg-server.postgres.database.azure.com:5432/exam_platform?sslmode=require

# ============================================
# Azure Cache for Redis (TLS on port 6380)
# ============================================
# Format: rediss://:<access-key>@<name>.redis.cache.windows.net:6380
# Get access key: az redis list-keys --resource-group exam-platform-rg --name exam-redis-cache
REDIS_URL=rediss://:YOUR_REDIS_ACCESS_KEY@exam-redis-cache.redis.cache.windows.net:6380

# ============================================
# Security
# ============================================
# JWT secret key - MUST be at least 32 characters
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ============================================
# Azure Blob Storage (for screenshots)
# ============================================
# Get connection string: az storage account show-connection-string --name examplatformstorage01
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=screenshots

# ============================================
# OR: AWS S3 (optional, if keeping existing S3)
# ============================================
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ============================================
# SSL Configuration (Let's Encrypt)
# ============================================
SSL_EMAIL=admin@your-domain.com

# ============================================
# Node Environment
# ============================================
NODE_ENV=production
