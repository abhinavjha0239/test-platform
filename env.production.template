# ============================================
# Exam Platform - Production Environment
# ============================================
# Copy this file to .env.production and fill in the values
# 
# SECURITY: Never commit .env.production to version control!
# ============================================

# ============================================
# Domain & URLs
# ============================================
# Your domain name (e.g., exam.yourdomain.com)
DOMAIN=your-domain.com

# Frontend URL (used for CORS and redirects)
FRONTEND_URL=https://your-domain.com

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD@postgres:5432/exam_platform

# PostgreSQL credentials (used by postgres container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_DB=exam_platform

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# Security
# ============================================
# JWT secret key - MUST be at least 32 characters
# Generate with: openssl rand -hex 32
JWT_SECRET=YOUR_32_CHARACTER_SECRET_HERE

# ============================================
# Grading Configuration
# ============================================
# Grader mode: docker (recommended), sandboxed, local
GRADER_MODE=docker
USE_DOCKER_GRADER=true

# Number of concurrent grading jobs (adjust based on VM resources)
# For e2-standard-2 (2 vCPU): use 2
# For e2-standard-4 (4 vCPU): use 4
# For e2-standard-8 (8 vCPU): use 6-8
GRADING_CONCURRENCY=6

# Docker group ID (find with: getent group docker | cut -d: -f3)
DOCKER_GID=999

# ============================================
# SSL Configuration (Let's Encrypt)
# ============================================
# Email for Let's Encrypt notifications
SSL_EMAIL=admin@your-domain.com

# ============================================
# Optional: Monitoring & Logging
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# Node Environment
# ============================================
NODE_ENV=production

